NODE_ENV=production
PORT=3000
# Cloud injects these after attaching PostgreSQL and a default object-storage bucket.
DATABASE_URL=
AWS_BUCKET=
AWS_ENDPOINT_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
APP_URL=
# Set these privately in Laravel Cloud. Never commit real values.
NANDU_ROOT_USER=veltra-admin
NANDU_ROOT_EMAIL=
NANDU_ROOT_PASSWD=
NANDU_JWT_SECRET=
